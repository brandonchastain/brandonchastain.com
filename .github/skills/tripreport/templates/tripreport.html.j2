<!DOCTYPE html>
<html>
  <head>
      <meta charset="utf-8">
      <link rel="stylesheet" href="../../css/style.css">
      <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
      <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
      <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
      <script src="https://unpkg.com/leaflet-gpx@1.7.0/gpx.js"></script>
  </head>
  <body>
    <div class="content col-6">
        <a href="../../tripreports.html">Trip Reports</a>
        <h1>{{ name }}</h1>
        <p class="summary">
            <strong>Region:</strong> {{ region }}<br/>
            <strong>Date:</strong> {{ date_str }}{% if time_window %} ({{ time_window|safe }}){% endif %}<br/>
            {% if distance_mi %}
            <strong>Distance:</strong> {{ "%.2f"|format(distance_mi) }} miles<br/>
            {% endif %}
            {% if gain_ft %}
            <strong>Gain:</strong> {{ "{:,}".format(gain_ft) }} feet<br/>
            {% endif %}
            {% if duration_str and duration_str != 'unknown' %}
            <strong>Duration:</strong> {{ duration_str }}{% if moving_str %} ({{ moving_str }} moving{% if stopped_str %}, {{ stopped_str }} stopped{% endif %}){% endif %}<br/>
            {% endif %}
            {% if avg_moving_mph %}
            <strong>Avg speed:</strong> {{ "%.2f"|format(avg_moving_mph) }} mph moving / {{ "%.2f"|format(avg_overall_mph) }} mph overall<br/>
            {% endif %}
            {% if weather %}
            <strong>Weather:</strong> {{ weather|safe }}<br/>
            {% endif %}
        </p>

        <h3>Route</h3>
        <div id="map" style="height:420px;width:100%;margin-bottom:1em;"></div>
        <script>
          (function () {
            var map = L.map('map');
            var satellite = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
              maxZoom: 19,
              attribution: 'Tiles &copy; Esri &mdash; Source: Esri, i-cubed, USDA, USGS, AEX, GeoEye, Getmapping, Aerogrid, IGN, IGP, UPR-EGP, and the GIS User Community'
            }).addTo(map);
            var topo = L.tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png', {
              maxZoom: 17,
              opacity: 0.5,
              attribution: 'Map data: &copy; OpenStreetMap contributors, SRTM | Map style: &copy; OpenTopoMap (CC-BY-SA)'
            }).addTo(map);

            var BlendControl = L.Control.extend({
              options: { position: 'topright' },
              onAdd: function () {
                var div = L.DomUtil.create('div', 'leaflet-bar');
                div.style.background = 'white';
                div.style.padding = '6px 8px';
                div.style.font = '12px/1.2 sans-serif';
                div.innerHTML =
                  '<div style="display:flex;justify-content:space-between;"><span>Satellite</span><span>Topo</span></div>' +
                  '<input type="range" min="0" max="100" value="50" style="width:140px;display:block;">';
                var slider = div.querySelector('input');
                L.DomEvent.disableClickPropagation(div);
                L.DomEvent.on(slider, 'input', function () {
                  topo.setOpacity(slider.value / 100);
                });
                return div;
              }
            });
            new BlendControl().addTo(map);

            {% if waypoint_only %}
            map.setView([{{ waypoint_lat }}, {{ waypoint_lon }}], 13);
            L.marker([{{ waypoint_lat }}, {{ waypoint_lon }}]).addTo(map);
            {% else %}
            new L.GPX('../../img/{{ slug }}/track.gpx', {
              async: true,
              polyline_options: { color: 'red', weight: 3, opacity: 0.9 },
              marker_options: {
                startIconUrl: null, endIconUrl: null, shadowUrl: null
              }
            }).on('loaded', function (e) {
              map.fitBounds(e.target.getBounds(), { padding: [20, 20] });
            }).addTo(map);
            {% endif %}

            window.tripMap = map;
          })();
        </script>
        {% if not waypoint_only %}
        <h3>Elevation Profile</h3>
        <img src="../../img/{{ slug }}/elevation.png" width="600"/>
        {% endif %}

        <div id="gallery-strip" class="gallery-strip"></div>
        <div id="lightbox" class="lightbox" hidden>
          <button class="lightbox-close" aria-label="Close">&times;</button>
          <button class="lightbox-prev" aria-label="Previous">&#10094;</button>
          <img class="lightbox-img" alt=""/>
          <button class="lightbox-next" aria-label="Next">&#10095;</button>
          <div class="lightbox-caption"></div>
        </div>
        <script>
          (function () {
            var photos = {{ photos_meta_json|safe }};
            if (!photos.length) return;
            var slug = "{{ slug }}";
            var stripEl = document.getElementById('gallery-strip');
            photos.forEach(function (p, i) {
              var img = document.createElement('img');
              img.src = '../../img/' + slug + '/' + p.file;
              img.loading = 'lazy';
              img.dataset.idx = i;
              img.addEventListener('click', function () { openLightbox(i); });
              stripEl.appendChild(img);
            });

            // Map dots: clickable markers on the route map sharing the same map instance.
            // The route-map block defines `map` inside an IIFE; re-resolve via DOM.
            // We attach to window.tripMap if exposed; otherwise we wait briefly.
            function addMapDots() {
              var m = window.tripMap;
              if (!m) { setTimeout(addMapDots, 200); return; }
              photos.forEach(function (p, i) {
                if (p.lat == null || p.lon == null) return;
                var dot = L.divIcon({
                  className: '',
                  html: '<div class="photo-dot" data-idx="' + i + '"></div>',
                  iconSize: [10, 10], iconAnchor: [5, 5]
                });
                var mk = L.marker([p.lat, p.lon], { icon: dot }).addTo(m);
                mk.on('click', function () { openLightbox(i); });
                p._marker = mk;
              });
            }
            addMapDots();

            var lb = document.getElementById('lightbox');
            var lbImg = lb.querySelector('.lightbox-img');
            var lbCap = lb.querySelector('.lightbox-caption');
            var cur = 0;
            function openLightbox(i) {
              cur = i; render(); lb.hidden = false;
            }
            function render() {
              var p = photos[cur];
              lbImg.src = '../../img/' + slug + '/' + p.file;
              lbCap.textContent = (cur + 1) + ' / ' + photos.length + (p.time ? ' — ' + p.time.replace('T', ' ').slice(0, 16) : '');
              // Highlight current marker
              photos.forEach(function (q, j) {
                if (!q._marker) return;
                var el = q._marker.getElement();
                if (el) el.querySelector('.photo-dot').classList.toggle('active', j === cur);
              });
            }
            lb.querySelector('.lightbox-close').onclick = function () { lb.hidden = true; };
            lb.querySelector('.lightbox-prev').onclick = function () { cur = (cur - 1 + photos.length) % photos.length; render(); };
            lb.querySelector('.lightbox-next').onclick = function () { cur = (cur + 1) % photos.length; render(); };
            document.addEventListener('keydown', function (e) {
              if (lb.hidden) return;
              if (e.key === 'Escape') lb.hidden = true;
              else if (e.key === 'ArrowLeft') lb.querySelector('.lightbox-prev').click();
              else if (e.key === 'ArrowRight') lb.querySelector('.lightbox-next').click();
            });
          })();
        </script>

    </div>
    <script src="../../js/site.js"></script>
  </body>
</html>
